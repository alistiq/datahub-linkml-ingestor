<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
           xmlns:owl="http://www.w3.org/2002/07/owl#"
           elementFormDefault="qualified">

  <xs:annotation>
    <xs:documentation>Sample schema root documentation</xs:documentation>
  </xs:annotation>

  <xs:element name="Root" type="xs:RootType">
    <xs:annotation>
      <xs:documentation>Root element documentation</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:attributeGroup name="CommonAttrs">
    <xs:annotation>
      <xs:documentation>Common attribute group</xs:documentation>
    </xs:annotation>
    <xs:attribute name="Id" type="xs:string">
      <xs:annotation>
        <xs:documentation>Identifier attribute</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <xs:complexType name="PersonType">
    <xs:annotation>
      <xs:documentation>A person</xs:documentation>
      <xs:appinfo>
        <owl:Class>
          <owl:exactMatch rdf:resource="https://example.org/ontology/Person"/>
        </owl:Class>
      </xs:appinfo>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="FirstName" type="xs:string" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Given name</xs:documentation>
          <xs:appinfo>
            <owl:DataProperty>
              <owl:exactMatch rdf:resource="https://example.org/ontology/firstName"/>
            </owl:DataProperty>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="Nickname" type="xs:string" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Nicknames, zero or more</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="status" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Status attribute</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="EmployeeType">
    <xs:complexContent>
      <xs:extension base="xs:PersonType">
        <xs:attribute name="employeeId" type="xs:string" use="required">
          <xs:annotation>
            <xs:documentation>Employee id</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attributeGroup ref="xs:CommonAttrs">
          <xs:annotation>
            <xs:documentation>Common attribute group ref</xs:documentation>
          </xs:annotation>
        </xs:attributeGroup>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="NoteType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="lang" type="xs:string" use="optional">
          <xs:annotation>
            <xs:documentation>Language of the note</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="ContactType">
    <xs:choice>
      <xs:element name="Email" type="xs:string" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Email contact</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Phone" type="xs:string" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Phone contact</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <xs:simpleType name="StatusCode">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="10"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
